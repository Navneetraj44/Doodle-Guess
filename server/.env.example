# Copy to server/.env for local use (the server reads real environment variables; use your shell or a tool like dotenv-cli).
PORT=3001

# Comma-separated list of browser origins the server allows via CORS.
# ── Split-deploy (Vercel + Render) ── set this to your Vercel frontend URL:
#   CLIENT_ORIGIN=https://your-app.vercel.app
# ── Local development ── the Vite dev server runs on 5173:
CLIENT_ORIGIN=http://localhost:5173
# ── Single-service (server serves client/dist) ── leave this unset or blank;
#   the server will serve the built client from the same origin, so no CORS is needed.

# Optional: folder with the built client to serve (single-service mode only).
# Defaults to ../client/dist relative to the compiled server entry point.
# Not used in split-deploy mode (Vercel hosts the client; Render hosts only the server).
# STATIC_DIR=
